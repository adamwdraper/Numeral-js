    "format",
    "time",
    "money",
    "percentage"
  ],
  "main": "./numeral.js",
  "types": "./numeral.d.ts",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adamwdraper/Numeral-js"
  },
