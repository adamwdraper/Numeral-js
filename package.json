{
  "name": "numeral",
  "version": "3.0.0",
  "description": "Format and manipulate numbers.",
  "homepage": "http://numeraljs.com",
  "author": {
    "name": "Adam Draper",
    "email": "adamwdraper@gmail.com",
    "url": "http://github.com/adamwdraper"
  },
  "keywords": [
    "numeral",
